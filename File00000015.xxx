function Trig_Map_WeatherActions takes nothing returns nothing
call TriggerSleepAction(35.00)
call TriggerExecute(gg_trg_Map_Random)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=6
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call EnableWeatherEffect(GetLastCreatedWeatherEffect(),false)
call RemoveWeatherEffect(GetLastCreatedWeatherEffect())
if((udg_Weather_A[bj_forLoopAIndex]==1))then
call AddWeatherEffectSaveLast(udg_Point_ALL,'RAhr')
call DisplayTimedTextToForce(GetPlayersAll(),20.00,"|cFF1FBF00天气预报：下大雨啦|r")
else
if((udg_Weather_A[bj_forLoopAIndex]==2))then
call AddWeatherEffectSaveLast(udg_Point_ALL,'SNbs')
call DisplayTimedTextToForce(GetPlayersAll(),20.00,"|cFF1FBF00天气预报：暴风雪来咯|r")
else
if((udg_Weather_A[bj_forLoopAIndex]==3))then
call AddWeatherEffectSaveLast(udg_Point_ALL,'LRaa')
call DisplayTimedTextToForce(GetPlayersAll(),20.00,"|cFF1FBF00天气预报：今天阳光明媚哦|r")
else
if((udg_Weather_A[bj_forLoopAIndex]==4))then
call AddWeatherEffectSaveLast(udg_Point_ALL,'LRma')
call DisplayTimedTextToForce(GetPlayersAll(),20.00,"|cFF1FBF00天气预报：月光来临|r")
else
if((udg_Weather_A[bj_forLoopAIndex]==5))then
call AddWeatherEffectSaveLast(udg_Point_ALL,'FDwh')
call DisplayTimedTextToForce(GetPlayersAll(),20.00,"|cFF1FBF00天气预报：起雾了|r")
else
if((udg_Weather_A[bj_forLoopAIndex]==6))then
call AddWeatherEffectSaveLast(udg_Point_ALL,'WOlw')
call DisplayTimedTextToForce(GetPlayersAll(),20.00,"|cFF1FBF00天气预报：起风了|r")
else
endif
endif
endif
endif
endif
endif
call EnableWeatherEffect(GetLastCreatedWeatherEffect(),true)
call TriggerSleepAction(150.00)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call TriggerExecute(gg_trg_Map_Weather)
endfunction
