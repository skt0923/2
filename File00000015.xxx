function Trig_Map_InitializationFunc004A takes nothing returns nothing
call CreateFogModifierRectBJ(true,GetEnumPlayer(),FOG_OF_WAR_VISIBLE,gg_rct_Show)
call SetPlayerFlagBJ(PLAYER_STATE_GIVES_BOUNTY,true,GetEnumPlayer())
call SetPlayerStateBJ(GetEnumPlayer(),PLAYER_STATE_RESOURCE_GOLD,300)
endfunction
function Trig_Map_InitializationFunc005Func001002002 takes nothing returns nothing
call RemoveUnit(GetEnumUnit())
endfunction
function Trig_Map_InitializationActions takes nothing returns nothing
call FogMaskEnableOn()
call FogEnableOn()
call SetMapFlag(MAP_LOCK_ALLIANCE_CHANGES,true)
call ForForce(GetPlayersAll(),function Trig_Map_InitializationFunc004A)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=5
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
if((GetPlayerSlotState(ConvertedPlayer(bj_forLoopAIndex))!=PLAYER_SLOT_STATE_PLAYING))then
call ForGroupBJ((YDWEGetUnitsOfPlayerMatchingNull((ConvertedPlayer(bj_forLoopAIndex)),null)),function Trig_Map_InitializationFunc005Func001002002)
else
call DoNothing()
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set udg_Point_ALL=GetEntireMapRect()
call TriggerExecute(gg_trg_Map_Weather)
call DestroyTrigger(GetTriggeringTrigger())
endfunction
function InitTrig_Map_Initialization takes nothing returns nothing
set gg_trg_Map_Initialization=CreateTrigger()
call TriggerAddAction(gg_trg_Map_Initialization,function Trig_Map_InitializationActions)
endfunction
function Trig_LeaveFunc002Func001002002 takes nothing returns nothing
call RemoveUnit(GetEnumUnit())
endfunction
function Trig_LeaveFunc003001001 takes nothing returns boolean
return((IsPlayerAlly(GetFilterPlayer(),GetTriggerPlayer())==true))
endfunction
function Trig_LeaveFunc003A takes nothing returns nothing
call SetPlayerTaxRate(GetTriggerPlayer(),GetEnumPlayer(),PLAYER_STATE_RESOURCE_GOLD,100)
call SetPlayerTaxRate(GetTriggerPlayer(),GetEnumPlayer(),PLAYER_STATE_RESOURCE_LUMBER,100)
endfunction
function Trig_LeaveActions takes nothing returns nothing
call RemoveUnit(GetEnumUnit())
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=5
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
if((GetPlayerSlotState(ConvertedPlayer(bj_forLoopAIndex))!=PLAYER_SLOT_STATE_PLAYING))then
call ForGroupBJ((YDWEGetUnitsOfPlayerMatchingNull((ConvertedPlayer(bj_forLoopAIndex)),null)),function Trig_LeaveFunc002Func001002002)
else
call DoNothing()
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call ForForce(YDWEGetPlayersMatchingNull(Condition(function Trig_LeaveFunc003001001)),function Trig_LeaveFunc003A)
endfunction
function InitTrig_Leave takes nothing returns nothing
set gg_trg_Leave=CreateTrigger()
call TriggerRegisterPlayerEventLeave(gg_trg_Leave,Player(0))
call TriggerRegisterPlayerEventLeave(gg_trg_Leave,Player(1))
call TriggerRegisterPlayerEventLeave(gg_trg_Leave,Player(2))
call TriggerRegisterPlayerEventLeave(gg_trg_Leave,Player(3))
call TriggerRegisterPlayerEventLeave(gg_trg_Leave,Player(4))
call TriggerAddAction(gg_trg_Leave,function Trig_LeaveActions)
endfunction
function Trig_WinFunc005002 takes nothing returns nothing
call CustomVictoryBJ(GetEnumPlayer(),true,false)
endfunction
function Trig_WinActions takes nothing returns nothing
call DisplayTimedTextToForce(GetPlayersAll(),30.00,"|cFFFF0000恭|r|cFF0041FF喜|r|cFF1BE6B8你|r|cFF530080胜|r|cFFFFFF00利|r|cFFFE9FD8了|r|cFF1FBF00！|r|cFFE55AAF！|r|cFF949596！|r")
call TriggerSleepAction(3.00)
call DisplayTimedTextToForce(GetPlayersAll(),5.00,"|cFFFF0000游|r|cFF802080戏|r|cFF0041FF将|r|cFF0E94DC在|r|cFF1BE6B83|r|cFF37739C0|r|cFF530080秒|r|cFFA98040后|r|cFFFFFF00退|r|cFFFECF6C出|r|cFFFE9FD8！|r|cFF8EAF6C！|r|cFF1FBF00！|r")
call TriggerSleepAction(30.00)
call ForForce(YDWEGetPlayersAlliesNull(Player(0)),function Trig_WinFunc005002)
endfunction
function InitTrig_Win takes nothing returns nothing
set gg_trg_Win=CreateTrigger()
call TriggerRegisterUnitEvent(gg_trg_Win,gg_unit_unp2_0000,EVENT_UNIT_DEATH)
call TriggerAddAction(gg_trg_Win,function Trig_WinActions)
endfunction
function Trig_EndConditions takes nothing returns boolean
return((GetUnitTypeId(GetTriggerUnit())=='htow'))
endfunction
function Trig_EndActions takes nothing returns nothing
call EnableTrigger(gg_trg_Huan)
call DisplayTimedTextToForce(GetPlayersAll(),30.00,(GetPlayerName(GetTriggerPlayer())+" |cFFFF0033的|r|cFFF90330基|r|cFFF3062D地|r|cFFED092A给|r|cFFE70C27秒|r|cFFE10F24了|r|cFFDB1221，|r|cFFD5151E真|r|cFFCF181B可|r|cFFC91B18怜|r|cFFC31E15.|r|cFFBD2112.|r|cFFB7240F.|r|cFFB1270C.|r|cFFAB2A09.|r|cFFA52D06.|r"))
endfunction
function InitTrig_End takes nothing returns nothing
set gg_trg_End=CreateTrigger()
